# Copy to web/.env.local to point the dashboard at a non-default API, or to
# match a custom webhook secret set on the FastAPI backend.

# Base URL of the running Recovery Agent API (default: http://localhost:8000)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Must match WEBHOOK_SECRET on the FastAPI backend (default: mocksecret123).
# Used server-side by app/api/simulate-webhook to sign the demo payment.failed event.
WEBHOOK_SECRET=mocksecret123
